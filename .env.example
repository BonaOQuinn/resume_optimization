# Chat model for planning, writing, and review, in provider:model syntax.
# MiniLM (sentence-transformers/all-MiniLM-L6-v2) remains the embedding model.
RESUME_CHAT_MODEL=anthropic:claude-opus-5-5

# Required for anthropic:* models. Keep the real key only in .env (never commit it).
ANTHROPIC_API_KEY=

# Optional explicit pdflatex executable (usually detected automatically).
# RESUME_PDFLATEX=C:/Users/YOUR_USER/AppData/Local/Programs/MiKTeX2/miktex/bin/x64/pdflatex.exe

# Local, fully private alternative: use the exact tag of a model you have pulled
# (check with `ollama list`). CPU-only machines are slow; expect minutes per call.
# RESUME_CHAT_MODEL=ollama:YOUR_INSTALLED_MODEL
# Ollama context window in tokens; must fit the job, sources, and draft.
# RESUME_OLLAMA_NUM_CTX=16384
