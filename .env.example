# Chat model for the orchestrator and subagents. MiniLM remains the embedding model.
# Set a tool-calling model using provider:model syntax before running agent.py.
RESUME_CHAT_MODEL=

# Context for the job, source resume, template, and retrieved evidence.
# Larger contexts require more memory. Ollama defaults here to 16384 tokens.
RESUME_OLLAMA_NUM_CTX=16384

# Local Ollama option: use the exact tag of a model you have downloaded.
# RESUME_CHAT_MODEL=ollama:YOUR_INSTALLED_MODEL

# Hosted providers need their LangChain integration package and API credentials.
# Keep real credentials in .env; do not commit .env.
